{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheapestram.com/data/atlas/schemas/category.schema.json",
  "title": "Hardware Radar Category",
  "description": "Canonical Atlas schema for hardware product categories.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "categoryId",
    "schemaVersion",
    "slug",
    "displayName",
    "shortName",
    "description",
    "parentCategoryId",
    "status",
    "aliases",
    "productTypes",
    "provenance",
    "metadata"
  ],
  "properties": {
    "categoryId": { "type": "string", "pattern": "^CAT-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "shortName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "parentCategoryId": {
      "type": ["string", "null"],
      "pattern": "^CAT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "ARCHIVED"] },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "productTypes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceUrl", "retrievedAt", "verifiedBy", "verificationStatus"],
      "properties": {
        "sourceUrl": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "verifiedBy": { "type": "string", "minLength": 1 },
        "verificationStatus": { "type": "string", "enum": ["VERIFIED", "PENDING", "REJECTED"] }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "updatedAt"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
