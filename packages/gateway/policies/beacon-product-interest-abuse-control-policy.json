{
  "schemaVersion": "1.0",
  "policyType": "BEACON_GATEWAY_ABUSE_CONTROL",
  "policyId": "beacon_gateway_product_interest_cloudflare_waf_v1",
  "enabled": true,
  "route": "/api/beacon/product-interest",
  "method": "POST",
  "mechanism": "CLOUDFLARE_WAF_RATE_LIMIT",
  "enforcementLayer": "EDGE_TRANSPORT",
